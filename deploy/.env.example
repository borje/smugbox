# Copy to .env (same directory as docker-compose.yml).

# Public origin of Smugbox, without trailing slash. Used for the links
# the Lightroom plug-in records ("Open album in browser").
PUBLIC_BASE_URL=https://photos.example.com

# Title shown in the browser tab and as the first item of the top bar.
# Defaults to "Smugbox".
SITE_TITLE=Smugbox

# Theme (look of the site). Every theme in the repo is built in (noir, glass,
# nyx, nyx2, nyx2noir); for your own, put its zip or folder in the data
# volume's themes/ directory (/data/themes) and set its id here.
# See themes/README.md. Restart to apply.
SITE_THEME=noir

# Networks whose X-Forwarded-For header is trusted (your reverse proxy).
# Comma-separated CIDRs or IPs. Leave empty when no proxy is in front.
TRUSTED_PROXY_CIDR=172.18.0.0/16

# Largest accepted upload in MB (full-size JPEGs are 5-30 MB, videos far more).
MAX_UPLOAD_MB=2000

# debug | info | warn | error
LOG_LEVEL=info
